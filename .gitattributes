# Force LF line endings for all text files (prevents CRLF issues on Windows clones)
* text=auto eol=lf

# Explicitly force LF for shell scripts and config files
*.sh    text eol=lf
*.env   text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.php   text eol=lf
*.jsx   text eol=lf
*.js    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.json  text eol=lf
*.sql   text eol=lf
*.md    text eol=lf
*.xml   text eol=lf
*.ini   text eol=lf
*.conf  text eol=lf

# CSV data files — normalize to LF (LOAD DATA INFILE uses LINES TERMINATED BY '\n')
*.csv   text eol=lf

# Windows-only files keep CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
